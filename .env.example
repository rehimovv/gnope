# Copy to .env and fill in. Never commit the real .env.
# Token from @BotFather
BOT_TOKEN=
# Public address of the app (webhook = BASE_URL/webhook)
BASE_URL=https://azelinux.com/tools/poeditor
# Optional
# DATA_DIR=data
# MAX_FILE_MB=5
# RETENTION_DAYS=14
# DAILY_UPLOAD_LIMIT=50
# DEVELOPER_NAME=Ramal Rahimov
# DEVELOPER_URL=https://azelinux.com
# DEVELOPER_TELEGRAM=rahimovramal
# SOURCE_URL=https://github.com/rehimovv/gnome-po-telegram-bot
# Optional: server IP, so Telegram skips DNS (use if setWebhook says "Failed to resolve host")
# WEBHOOK_IP=
# Optional relay (relay/telegram-relay.php on another host) for hosts that reach Telegram badly
# TELEGRAM_RELAY_URL=https://other-host.example/tg-relay/telegram-relay.php
# TELEGRAM_RELAY_KEY=
